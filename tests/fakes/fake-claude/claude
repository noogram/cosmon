#!/usr/bin/env bash
# fake-claude — stand-in for the `claude` CLI used by `cs tackle`.
#
# Selects behavior via FAKE_CLAUDE_MODE. The goal is to reproduce the
# failure modes that showed up in production (task-4046 zombie, task-25c3
# auth prompt, …) at the syscall/exit-code boundary, without depending on
# the real Anthropic CLI or network.
#
# ── Modes (FAKE_CLAUDE_MODE=…) ─────────────────────────────────────────────
#   exit-0          exit cleanly with status 0 (default)
#   exit-42         exit immediately with status 42
#   exit-delayed    sleep 2s, then exit 1 (mid-spawn death)
#   hang            loop forever — simulate frozen worker
#   segfault        kill -SIGSEGV $$ — simulate native crash
#   auth-prompt     print "authentication required" to stderr, exit 1
#   partial-output  write a couple of events.jsonl lines, then die
#   echo-prompt     echo argv + stdin to stdout then exit 0
#   complete-molecule
#                   read the briefing off stdin, find the molecule id in it,
#                   and run `cs complete <id>` — the smallest worker that
#                   actually finishes its molecule. Used by the container
#                   e2e (scripts/rpp-remote-e2e.sh) to prove that a worker
#                   the rpp-adapter spawned can drive `cs` against the
#                   tenant store. Requires `cs` on PATH and a resolvable
#                   state dir (COSMON_STATE_DIR, which the adapter's worker
#                   envelope pins). Knobs: FAKE_CLAUDE_READ_TIMEOUT (default
#                   120s of silence before giving up), FAKE_CLAUDE_DONE_FILE
#                   (a breadcrumb written with the id it acted on),
#                   FAKE_CLAUDE_LINGER (seconds to stay alive after
#                   completing, default 120 — see the mode's own comment),
#                   FAKE_CLAUDE_NO_COMMIT (skip the worker's own commit, for
#                   a test that wants the empty-branch shape on purpose).
#                   It commits one file in its worktree before completing,
#                   so the branch it leaves is one a harvest can merge.
#
# ── Debug hooks ────────────────────────────────────────────────────────────
#   PROMPT_ECHO=1            tee stdin + argv to $FAKE_CLAUDE_LOG before acting
#   FAKE_CLAUDE_LOG=<path>   destination for PROMPT_ECHO (default stderr)
#
# Argv parsing is tolerant: we swallow flags we don't care about (e.g.
# --permission-mode <mode>, --dangerously-skip-permissions) and treat
# everything else as a positional no-op.

set -u

mode="${FAKE_CLAUDE_MODE:-exit-0}"
log="${FAKE_CLAUDE_LOG:-/dev/stderr}"

if [ -n "${PROMPT_ECHO:-}" ]; then
    {
        echo "fake-claude argv: $*"
        echo "fake-claude mode: $mode"
        echo "--- stdin ---"
        if [ ! -t 0 ]; then
            cat
        fi
        echo "--- /stdin ---"
    } >> "$log"
fi

# Consume (ignore) flags before routing so agents can invoke us the same
# way they invoke the real binary.
while [ $# -gt 0 ]; do
    case "$1" in
        --permission-mode) shift 2 ;;
        --dangerously-skip-permissions) shift ;;
        --print|--append-system-prompt) shift ;;
        --model) shift 2 ;;
        --version)
            echo "fake-claude 0.1.0 (cosmon spawn-matrix test fake)"
            exit 0
            ;;
        --help|-h)
            echo "fake-claude: stand-in for Anthropic's claude CLI."
            echo "Set FAKE_CLAUDE_MODE to control behavior."
            exit 0
            ;;
        *) shift ;;
    esac
done

case "$mode" in
    exit-0)
        exit 0
        ;;
    exit-42)
        exit 42
        ;;
    exit-delayed)
        sleep 2
        exit 1
        ;;
    hang)
        # Sleep in small increments so the process is killable. A single
        # `sleep 99999` would also work but makes graceful_exit tests slow
        # when a kill-TERM handler has to interrupt it.
        while true; do
            sleep 1
        done
        ;;
    segfault)
        # SIGSEGV on self; child exit status reflects the signal (139).
        kill -SEGV $$
        # If SIGSEGV was caught (rare), still die.
        exit 139
        ;;
    auth-prompt)
        printf 'authentication required; please run `claude login`\n' >&2
        exit 1
        ;;
    partial-output)
        # Simulate a worker that emits a couple of NDJSON events before
        # dying. The harness can grep for these in capture-pane output.
        cat <<'EOF'
{"type":"system","subtype":"init","message":"fake-claude starting"}
{"type":"assistant","message":{"content":[{"type":"text","text":"hello"}]}}
EOF
        exit 1
        ;;
    complete-molecule)
        # The briefing arrives the way a real agent receives it: pasted
        # into the pane's tty by the transport port, then submitted. We
        # read lines until one carries a cosmon molecule id.
        #
        # `read -t` is what keeps this from being the mute hang the fleet
        # cannot distinguish from work: a briefing that never arrives ends
        # as a NAMED failure on stderr, not a pane that idles forever.
        id=""
        while IFS= read -r -t "${FAKE_CLAUDE_READ_TIMEOUT:-120}" line; do
            candidate="$(printf '%s\n' "$line" \
                | grep -oE '\b[a-z][a-z0-9]*-[0-9]{8}-[0-9a-f]{4}\b' \
                | head -1)"
            if [ -n "$candidate" ]; then
                id="$candidate"
                break
            fi
        done
        if [ -z "$id" ]; then
            echo "fake-claude: no molecule id in the briefing (or none arrived)" >&2
            exit 3
        fi
        # Do the WORK before declaring it done.
        #
        # A worker that completes its molecule and commits nothing leaves
        # a branch with no commits, and `cs done` then archives it
        # without a merge: outcome `closed_without_merge`, `merged` false,
        # nothing on the trunk. That is a legitimate outcome for a
        # delib-shaped molecule and a useless one for a harness whose job
        # is to prove the harvest reaches git — the container e2e's merge
        # assertion cannot exist without a commit to merge. So this mode
        # writes one file and commits it, in the worktree the dispatch cut
        # for it, which is the smallest thing a worker can do that a
        # harvest has anything to say about.
        #
        # Identity comes from the repository config (the tenant tree the
        # worktree hangs off), not from `$HOME`: a worker runs under an
        # `env -i` envelope whose home holds no git identity at all.
        # `FAKE_CLAUDE_NO_COMMIT=1` skips the commit for a test that wants
        # the empty-branch shape on purpose.
        if [ -z "${FAKE_CLAUDE_NO_COMMIT:-}" ]; then
            printf 'work by fake-claude for %s\n' "$id" >"worker-output-$id.txt"
            if ! git add "worker-output-$id.txt" \
                || ! git commit -q -m "feat($id): fake-claude worker output"; then
                echo "fake-claude: could not commit the worker's output in $PWD" >&2
                exit 5
            fi
        fi

        # One shot, then CHECK. The exit code alone is not enough:
        # `cs complete` on an id it cannot find prints
        # "error completing <id>: molecule not found" and still exits 0,
        # so a fake that trusted the status would report success for a
        # molecule it never touched — and the e2e would then blame the
        # spawn for a completion that never happened.
        cs complete "$id" --reason "fake-claude complete-molecule" || true
        if ! cs --json observe "$id" | grep -q '"status": *"completed"'; then
            echo "fake-claude: $id is not completed after cs complete" >&2
            exit 4
        fi
        if [ -n "${FAKE_CLAUDE_DONE_FILE:-}" ]; then
            printf '%s\n' "$id" >"$FAKE_CLAUDE_DONE_FILE"
        fi
        # Then STAY ALIVE, like the agent this stands in for.
        #
        # Not cosmetic. The transport delivers a briefing as
        # load-buffer -> paste-buffer -> a trailing submit key, and a
        # worker that exits the instant it reads the paste takes its tmux
        # session — and, if it is the only one, the whole tmux server —
        # down between the paste and the submit. The submit then fails,
        # the dispatch is reported as a SPAWN failure, and its ledger
        # entry and worktree are rolled back under a molecule that is by
        # then already `completed`. Every part of that is a real
        # sequence, observed in the container smoke; none of it is what
        # the smoke is trying to measure. A real `claude` never
        # disappears mid-briefing, so neither does this.
        sleep "${FAKE_CLAUDE_LINGER:-120}"
        exit 0
        ;;
    echo-prompt)
        echo "fake-claude echo-prompt argv: $*"
        if [ ! -t 0 ]; then
            cat
        fi
        exit 0
        ;;
    *)
        echo "fake-claude: unknown FAKE_CLAUDE_MODE=$mode" >&2
        exit 2
        ;;
esac
